# Copy to .env only if you need to override the defaults below.
# Each service validates its variables at startup (src/config/config.schema.ts).
# Nothing loads .env on its own (ignoreEnvFile): export the variables, or set them in a script.

# gateway
PORT=8080
# Abuse limits (design §11). Each defaults to the value shown.
# MAX_PAYLOAD_BYTES=16384
# INVALID_MESSAGES_BEFORE_DISCONNECT=3
# MESSAGES_PER_SECOND=60
# MESSAGE_BURST=120
# CONNECTIONS_PER_IP=10
# NEW_CONNECTIONS_PER_IP_PER_MINUTE=30
# ROOMS_PER_IP_PER_MINUTE=3
# SESSIONS_PER_IP_PER_MINUTE=10
# FAILED_JOINS_PER_IP_PER_MINUTE=10
# MAX_SPECTATORS=16
# QUICK_MATCH_COOLDOWN_MS=3000
# Addresses and CIDR ranges (comma-separated) the per-IP limits don't apply to. The gateway's own
# default is none; this file and the gateway's `pnpm dev` script set loopback, so a laptop running
# web, CLI and bots isn't blocked.
LIMITS_EXEMPT_IPS=127.0.0.1,::1
# The peers (addresses or CIDR ranges) whose X-Forwarded-For is believed: the load balancer.
# TRUSTED_PROXIES=

# game (pnpm dev:game2 runs a second instance with PORT=8082)
# PORT=8081
# The pod's own IP, which its heartbeat advertises to gateways with its port (design §9.2).
# POD_IP=127.0.0.1

# Valkey, started by `pnpm dev` via docker compose (gateway and game)
# VALKEY_URL=redis://localhost:6379
# Prepended to every key and channel, to share one Valkey between setups.
# VALKEY_PREFIX=

# bot tool (testing only, design §13.4): `pnpm dev:bot`, then `pnpm bot join <CODE>`
# BOT_PORT=8090
# The gateway's HTTP origin, which the bots connect to like any client.
# GATEWAY_URL=http://127.0.0.1:8080
# Seeds every bot's choices, to replay a run. Random if unset.
# BOT_SEED=
# Where `pnpm bot` finds the bot tool.
# BOT_URL=http://127.0.0.1:8090
