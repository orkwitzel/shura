# Copy to .env only if you need to override the defaults below.
# Each service validates its variables at startup (src/config.ts).

# gateway
PORT=8080
# The abuse limits (docs/design.md §11). The per-IP limits skip these addresses, so a laptop
# running web, CLI and bot clients at once isn't blocked (`pnpm dev` sets the same for the gateway).
LIMITS_EXEMPT_IPS=127.0.0.1,::1
# The peers (addresses or CIDR ranges) whose X-Forwarded-For is believed: the load balancer's
# TRUSTED_PROXIES=
# MAX_PAYLOAD_BYTES=16384
# INVALID_MESSAGES_BEFORE_DISCONNECT=3
# MESSAGES_PER_SECOND=60
# MESSAGE_BURST=120
# CONNECTIONS_PER_IP=10
# NEW_CONNECTIONS_PER_IP_PER_MINUTE=30
# ROOMS_PER_IP_PER_MINUTE=3
# HOSTED_ROOMS_PER_SESSION=1
# FAILED_JOINS_PER_IP_PER_MINUTE=10
# MAX_SPECTATORS=16
# QUICK_MATCH_COOLDOWN_MS=3000

# game (pnpm dev:game2 runs a second instance with PORT=8082)
# PORT=8081
# The pod's id in its heartbeat, and the IP gateways reach it at (address POD_IP:PORT)
# POD_ID=<hostname>
# POD_IP=localhost

# both: Valkey, started by `pnpm dev` via docker compose
# VALKEY_URL=redis://localhost:6379
# A prefix for every key and channel, so several stacks can share one Valkey
# VALKEY_PREFIX=
# pino's level (pretty-printed outside NODE_ENV=production)
# LOG_LEVEL=info

# bot tool (testing only, `pnpm dev:bot`): its HTTP API's port, the gateway its bots connect to,
# and a seed to replay a run of bots
# BOT_PORT=8090
# GATEWAY_URL=ws://localhost:8080
# BOT_SEED=
