{
  "name": "shura",
  "version": "0.0.0",
  "private": true,
  "description": "Online multiplayer falling-block battles in your terminal",
  "type": "module",
  "license": "AGPL-3.0-only",
  "bin": {
    "shura": "dist/shura.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --sourcemap --banner:js='#!/usr/bin/env node' --outfile=dist/shura.js",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@shura/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
