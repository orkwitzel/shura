{
  "name": "@shura/game",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./app.module": "./src/app.module.ts",
    "./configure-app": "./src/configure-app.ts",
    "./clock": "./src/clock/index.ts",
    "./match": "./src/match/index.ts",
    "./rooms": "./src/rooms/index.ts",
    "./valkey": "./src/valkey/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest build && concurrently --kill-others --names build,run \"nest build --watch --preserveWatchOutput\" \"NODE_ENV=${NODE_ENV:-development} node --watch --enable-source-maps dist/main.js\"",
    "build": "nest build",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc",
    "test": "vitest run --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-ws": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@shura/engine": "workspace:*",
    "@shura/protocol": "workspace:*",
    "@shura/valkey": "workspace:*",
    "bufferutil": "4.1.0",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/schematics": "catalog:",
    "@nestjs/testing": "catalog:",
    "@shura/tsconfig": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "concurrently": "catalog:",
    "pino-pretty": "catalog:",
    "typescript": "catalog:nest",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
