{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "swc",
      "options": { "swcrcPath": ".swcrc" }
    },
    "typeCheck": false,
    "deleteOutDir": false
  },
  "generateOptions": {
    "flat": false,
    "spec": false
  }
}
