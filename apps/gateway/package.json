{
  "name": "@shura/gateway",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node26 --sourcemap --outfile=dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@shura/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
