{
  "name": "shura-monorepo",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "docker compose up -d --wait valkey && turbo run dev",
    "dev:game2": "PORT=8082 pnpm --filter @shura/game dev",
    "cli": "pnpm --filter shura dev",
    "check": "biome check && turbo run typecheck test",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "biome check --write",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@changesets/cli": "3.0.3",
    "@types/node": "catalog:",
    "lefthook": "2.2.2",
    "turbo": "2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
