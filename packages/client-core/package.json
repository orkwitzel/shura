{
  "name": "@shura/client-core",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --no-clean",
    "typecheck": "tsc",
    "test": "vitest run --passWithNoTests --fsModuleCachePath node_modules/.vitest-cache"
  },
  "dependencies": {
    "@shura/engine": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@shura/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zustand": "catalog:"
  }
}
