{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!tests/**", "!scripts/**", "!recorded-matches/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["VALKEY_URL"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "LOG_LEVEL",
        "NODE_ENV",
        "POD_ID",
        "POD_IP",
        "VALKEY_URL",
        "VALKEY_PREFIX",
        "MAX_PAYLOAD_BYTES",
        "INVALID_MESSAGES_BEFORE_DISCONNECT",
        "MESSAGES_PER_SECOND",
        "MESSAGE_BURST",
        "CONNECTIONS_PER_IP",
        "NEW_CONNECTIONS_PER_IP_PER_MINUTE",
        "ROOMS_PER_IP_PER_MINUTE",
        "SESSIONS_PER_IP_PER_MINUTE",
        "FAILED_JOINS_PER_IP_PER_MINUTE",
        "MAX_SPECTATORS",
        "QUICK_MATCH_COOLDOWN_MS",
        "LIMITS_EXEMPT_IPS",
        "TRUSTED_PROXIES"
      ]
    }
  }
}
